---
import { getCollection } from "astro:content";
import { withBase } from "../lib/url";
import PageTemplate from "../components/PageTemplate.astro";
import EntryList from "../components/EntryList.astro";
import { Content, frontmatter } from "../content/pages/enciclopedia.md";

const terminos = (await getCollection("enciclopedia")).sort((a, b) => a.data.title.localeCompare(b.data.title));
const entries = terminos.map((entry) => ({
    href: withBase(`/enciclopedia/${entry.data.slug ?? entry.id}`),
    title: entry.data.title,
    summary: entry.data.summary,
}));

const jsonLd = {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: frontmatter.title,
    description: frontmatter.description,
    inLanguage: "es-CL",
    hasPart: terminos.map((entry) => ({
        "@type": "Article",
        headline: entry.data.title,
        url: new URL(`/enciclopedia/${entry.data.slug ?? entry.id}`, Astro.site).href,
    })),
};
---

<PageTemplate frontmatter={frontmatter} Content={Content} jsonLd={jsonLd}>
    <EntryList entries={entries} emptyLabel="Aún no hay términos publicados en la enciclopedia." />
</PageTemplate>
