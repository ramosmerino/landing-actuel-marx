---
import { getCollection } from "astro:content";
import { withBase } from "../../lib/url";
import PageTemplate from "../../components/PageTemplate.astro";
import EntryList from "../../components/EntryList.astro";
import { Content, frontmatter } from "../../content/pages/separatas.md";

const posts = (await getCollection("blog", ({ data }) => data.section === "separatas")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const entries = posts.map((entry) => ({
    href: withBase(`/blog/${entry.data.slug ?? entry.id}`),
    title: entry.data.title,
    date: entry.data.pubDate,
    summary: entry.data.summary,
}));

const jsonLd = {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: frontmatter.title,
    description: frontmatter.description,
    inLanguage: "es-CL",
    hasPart: posts.map((entry) => ({
        "@type": "Article",
        headline: entry.data.title,
        url: new URL(`/blog/${entry.data.slug ?? entry.id}`, Astro.site).href,
    })),
};
---

<PageTemplate frontmatter={frontmatter} Content={Content} jsonLd={jsonLd}>
    <EntryList entries={entries} emptyLabel="Aún no hay separatas publicadas." />
</PageTemplate>
