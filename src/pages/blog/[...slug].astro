---
import { getCollection, render } from "astro:content";
import EntryTemplate from "../../components/EntryTemplate.astro";

const SECTION_LABELS: Record<string, { href: string; label: string }> = {
    "columnas-de-opinion": { href: "/blog/columnas-de-opinion", label: "Columnas de Opinión" },
    "cuadernos-tematicos": { href: "/blog/cuadernos-tematicos", label: "Cuadernos Temáticos" },
    separatas: { href: "/blog/separatas", label: "Separatas" },
};

export async function getStaticPaths() {
    const posts = await getCollection("blog");
    return posts.map((entry) => ({
        params: { slug: entry.data.slug ?? entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const section = SECTION_LABELS[entry.data.section];
---

<EntryTemplate
    title={entry.data.title}
    pubDate={entry.data.pubDate}
    summary={entry.data.summary}
    backHref={section.href}
    backLabel={section.label}
    Content={Content}
/>
