---
import { getCollection } from "astro:content";
import { withBase } from "../lib/url";
import PageTemplate from "../components/PageTemplate.astro";
import EntryList from "../components/EntryList.astro";
import { Content, frontmatter } from "../content/pages/convocatorias.md";

const convocatorias = (await getCollection("convocatorias")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const entries = convocatorias.map((entry) => ({
    href: withBase(`/convocatorias/${entry.data.slug ?? entry.id}`),
    title: `${entry.data.title} (${entry.data.status === "abierta" ? "Abierta" : "Cerrada"})`,
    date: entry.data.pubDate,
    summary: entry.data.summary,
}));

const jsonLd = {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: frontmatter.title,
    description: frontmatter.description,
    inLanguage: "es-CL",
    hasPart: convocatorias.map((entry) => ({
        "@type": "Article",
        headline: entry.data.title,
        url: new URL(`/convocatorias/${entry.data.slug ?? entry.id}`, Astro.site).href,
    })),
};
---

<PageTemplate frontmatter={frontmatter} Content={Content} jsonLd={jsonLd}>
    <EntryList entries={entries} emptyLabel="Aún no hay convocatorias publicadas." />
</PageTemplate>
