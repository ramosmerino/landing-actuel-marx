---
import { getCollection, render } from "astro:content";
import EntryTemplate from "../../components/EntryTemplate.astro";

export async function getStaticPaths() {
    const noticias = await getCollection("noticias");
    return noticias.map((entry) => ({
        params: { slug: entry.data.slug ?? entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<EntryTemplate
    title={entry.data.title}
    pubDate={entry.data.eventDate ?? entry.data.pubDate}
    summary={entry.data.summary}
    backHref="/noticias-y-eventos"
    backLabel="Noticias y Eventos"
    Content={Content}
/>
