---
import { getCollection, render } from "astro:content";
import { withBase } from "../../lib/url";
import EntryTemplate from "../../components/EntryTemplate.astro";

export async function getStaticPaths() {
    const convocatorias = await getCollection("convocatorias");
    return convocatorias.map((entry) => ({
        params: { slug: entry.data.slug ?? entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<EntryTemplate
    title={entry.data.title}
    pubDate={entry.data.pubDate}
    summary={entry.data.summary}
    backHref={withBase("/convocatorias")}
    backLabel="Convocatorias"
    Content={Content}
/>
