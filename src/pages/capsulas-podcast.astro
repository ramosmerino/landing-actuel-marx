---
import { getCollection } from "astro:content";
import { withBase } from "../lib/url";
import PageTemplate from "../components/PageTemplate.astro";
import EntryList from "../components/EntryList.astro";
import { Content, frontmatter } from "../content/pages/capsulas-podcast.md";

const capsulas = (await getCollection("capsulas")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const entries = capsulas.map((entry) => ({
    href: withBase(`/capsulas-podcast/${entry.data.slug ?? entry.id}`),
    title: entry.data.title,
    date: entry.data.pubDate,
    summary: entry.data.summary,
}));

const jsonLd = {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: frontmatter.title,
    description: frontmatter.description,
    inLanguage: "es-CL",
    hasPart: capsulas.map((entry) => ({
        "@type": "Article",
        headline: entry.data.title,
        url: new URL(`/capsulas-podcast/${entry.data.slug ?? entry.id}`, Astro.site).href,
    })),
};
---

<PageTemplate frontmatter={frontmatter} Content={Content} jsonLd={jsonLd}>
    <EntryList entries={entries} emptyLabel="Aún no hay cápsulas o episodios publicados." />
</PageTemplate>
