---
import { getCollection } from "astro:content";
import { withBase } from "../lib/url";
import PageTemplate from "../components/PageTemplate.astro";
import EntryList from "../components/EntryList.astro";
import { Content, frontmatter } from "../content/pages/capsulas-podcast.md";

const capsulas = (await getCollection("capsulas")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const entries = capsulas.map((entry) => ({
    href: withBase(`/capsulas-podcast/${entry.data.slug ?? entry.id}`),
    title: entry.data.title,
    date: entry.data.pubDate,
    summary: entry.data.summary,
}));
---

<PageTemplate frontmatter={frontmatter} Content={Content}>
    <EntryList entries={entries} emptyLabel="Aún no hay cápsulas o episodios publicados." />
</PageTemplate>
