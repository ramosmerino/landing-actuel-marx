---
import "../styles/colors.css";
import "../styles/content-prose.css";
import { withBase } from "../lib/url";

import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  description?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  type?: "website" | "article" | "book";
  publishedTime?: Date;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const SITE_NAME = "Actuel Marx Intervenciones";
const DEFAULT_DESCRIPTION =
  "Actuel Marx Intervenciones es una variante editorial de la revista francesa Actuel Marx";

const {
  title,
  description = DEFAULT_DESCRIPTION,
  image,
  imageAlt,
  type = "website",
  publishedTime,
  noindex = false,
  jsonLd,
} = Astro.props;

const fullTitle = title === SITE_NAME ? title : `${title} | ${SITE_NAME}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const ogImage = image
  ? await getImage({ src: image, width: 1200, format: "jpg" })
  : undefined;
const ogImageUrl = new URL(
  ogImage?.src ?? withBase("/img/og-default.png"),
  Astro.site,
).href;
const ogImageAlt = imageAlt ?? (image ? title : SITE_NAME);
const ogImageWidth = ogImage?.attributes.width ?? 1200;
const ogImageHeight = ogImage?.attributes.height ?? 630;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#be2e2a" />
    <link rel="icon" type="image/png" href={withBase("/favicon.png")} />
    <link rel="apple-touch-icon" href={withBase("/favicon.png")} />
    <link rel="sitemap" href={withBase("/sitemap-index.xml")} />

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Open+Sans:wght@400;600;700&display=swap" rel="stylesheet">
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: 'Open Sans', sans-serif;
    color: var(--color-neutral-800);
    line-height: 1.6;
    background-color: var(--color-neutral-100);
  }

  a {
    text-decoration: none;
    color: inherit;
  }

  ul {
    list-style: none;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: 'Libre Baskerville', serif;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }
</style>
