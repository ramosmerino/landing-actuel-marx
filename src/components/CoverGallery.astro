---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

import {
    buildNumerosByNumber,
    getNumeroSlug,
    resolvePurchaseUrl,
} from "../lib/numeros";
import { withBase } from "../lib/url";

const [covers, numeros] = await Promise.all([
    getCollection("portadas"),
    getCollection("numeros"),
]);

const numerosByNumber = buildNumerosByNumber(numeros);

const sortedCovers = covers.sort(
    (a, b) => (a.data.number ?? Infinity) - (b.data.number ?? Infinity),
);
---

<div class="cover-grid">
    {sortedCovers.map((cover) => {
        const numero =
            cover.data.number !== undefined
                ? numerosByNumber.get(cover.data.number)
                : undefined;
        const detailHref = numero
            ? withBase(`/numeros-anteriores/${getNumeroSlug(numero)}`)
            : undefined;
        const purchaseUrl =
            numero && cover.data.number !== undefined
                ? resolvePurchaseUrl(numero, cover)
                : cover.data.purchaseUrl;

        const alt = cover.data.number
            ? `Actuel Marx Intervenciones N°${cover.data.number}${cover.data.title ? " - " + cover.data.title : ""}`
            : cover.data.title;

        return (
            <figure class="cover-item">
                {detailHref ? (
                    <a class="cover-link" href={detailHref}>
                        <Image
                            src={cover.data.cover}
                            alt={alt}
                            loading="lazy"
                            widths={[240, 480]}
                            sizes="(min-width: 900px) 240px, 45vw"
                        />
                    </a>
                ) : (
                    <Image
                        src={cover.data.cover}
                        alt={alt}
                        loading="lazy"
                        widths={[240, 480]}
                        sizes="(min-width: 900px) 240px, 45vw"
                    />
                )}
                {(cover.data.number || cover.data.title) && (
                    <figcaption>
                        {detailHref ? (
                            <a class="cover-detail-link" href={detailHref}>
                                {cover.data.number && (
                                    <span class="cover-number">N°{cover.data.number}</span>
                                )}
                                {cover.data.title && (
                                    <span class="cover-title">{cover.data.title}</span>
                                )}
                            </a>
                        ) : (
                            <>
                                {cover.data.number && (
                                    <span class="cover-number">N°{cover.data.number}</span>
                                )}
                                {cover.data.title && (
                                    <span class="cover-title">{cover.data.title}</span>
                                )}
                            </>
                        )}
                        {purchaseUrl && (
                            <a
                                class="cover-lom-link"
                                href={purchaseUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                LOM
                            </a>
                        )}
                    </figcaption>
                )}
            </figure>
        );
    })}
</div>

<style>
    .cover-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
        gap: 24px;
        margin-top: 30px;
    }

    .cover-item {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .cover-link {
        display: block;
    }

    .cover-item img {
        width: 100%;
        aspect-ratio: 3 / 4;
        object-fit: cover;
        border-radius: 4px;
        box-shadow: 0 4px 12px var(--overlay-black-15);
        transition: transform 0.3s ease;
    }

    .cover-link:hover img {
        transform: translateY(-4px);
    }

    figcaption {
        display: flex;
        flex-direction: column;
        font-size: 0.8rem;
        color: var(--color-neutral-700);
        text-align: center;
        gap: 4px;
    }

    .cover-detail-link {
        display: flex;
        flex-direction: column;
        text-decoration: none;
        color: inherit;
    }

    .cover-detail-link:hover .cover-number {
        text-decoration: underline;
    }

    .cover-number {
        font-family: "Libre Baskerville", serif;
        font-weight: 700;
        color: var(--color-primary);
    }

    .cover-title {
        text-transform: capitalize;
        color: var(--color-neutral-500);
    }

    .cover-lom-link {
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--color-primary);
        text-decoration: none;
        letter-spacing: 0.03em;
    }

    .cover-lom-link:hover {
        text-decoration: underline;
    }
</style>
