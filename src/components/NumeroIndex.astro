---
export interface NumeroArticle {
    title: string;
    authors: string;
    separataSlug?: string;
}

export interface Props {
    articles: NumeroArticle[];
    separataHrefs: Map<string, string>;
}

const { articles, separataHrefs } = Astro.props;
---

<section class="numero-index" aria-labelledby="numero-index-heading">
    <h2 id="numero-index-heading">Índice</h2>
    {
        articles.length === 0 ? (
            <p class="numero-index-empty">Índice en preparación.</p>
        ) : (
            <ol class="numero-index-list">
                {articles.map((article) => {
                    const href =
                        article.separataSlug !== undefined
                            ? separataHrefs.get(article.separataSlug)
                            : undefined;

                    return (
                        <li class="numero-index-item">
                            <span class="numero-index-title">
                                {href ? (
                                    <a href={href}>{article.title}</a>
                                ) : (
                                    article.title
                                )}
                            </span>
                            <span class="numero-index-authors">{article.authors}</span>
                        </li>
                    );
                })}
            </ol>
        )
    }
</section>

<style>
    .numero-index {
        margin-top: 40px;
        margin-bottom: 40px;
    }

    .numero-index h2 {
        font-family: "Libre Baskerville", serif;
        font-size: 1.35rem;
        color: var(--color-primary);
        margin-bottom: 20px;
    }

    .numero-index-empty {
        color: var(--color-neutral-600);
        font-style: italic;
    }

    .numero-index-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .numero-index-item {
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding-bottom: 16px;
        border-bottom: 1px solid var(--color-neutral-200, #e5e5e5);
    }

    .numero-index-item:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }

    .numero-index-title {
        font-weight: 600;
        color: var(--color-neutral-900);
        line-height: 1.4;
    }

    .numero-index-title a {
        color: var(--color-primary);
        text-decoration: none;
    }

    .numero-index-title a:hover {
        text-decoration: underline;
    }

    .numero-index-authors {
        font-size: 0.9rem;
        color: var(--color-neutral-600);
        line-height: 1.5;
    }
</style>
