---
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

import Layout from "../layouts/Layout.astro";
import Header from "./Header.astro";
import Navigation from "./Navigation.astro";
import Footer from "./Footer.astro";
import NumeroIndex from "./NumeroIndex.astro";
import type { NumeroArticle } from "./NumeroIndex.astro";
import { formatDate } from "../lib/formatDate";

export interface Props {
    title: string;
    number: number;
    pubDate: Date;
    summary: string;
    articles: NumeroArticle[];
    separataHrefs: Map<string, string>;
    purchaseUrl?: string;
    pdfUrl?: string;
    coverImage?: ImageMetadata;
    coverAlt?: string;
    backHref: string;
    backLabel: string;
    Content?: AstroComponentFactory;
}

const {
    title,
    number,
    pubDate,
    summary,
    articles,
    separataHrefs,
    purchaseUrl,
    pdfUrl,
    coverImage,
    coverAlt,
    backHref,
    backLabel,
    Content,
} = Astro.props;

const pageTitle = title.includes("N°") ? title : `N°${number} — ${title}`;
const resolvedCoverAlt =
    coverAlt ?? `Portada de Actuel Marx Intervenciones N°${number}`;
---

<Layout title={pageTitle}>
    <Header />
    <Navigation />
    <main>
        <article class="numero container">
            <a class="numero-back" href={backHref}>&larr; {backLabel}</a>

            <div class="numero-header">
                {
                    coverImage && (
                        <figure class="numero-cover">
                            <Image
                                src={coverImage}
                                alt={resolvedCoverAlt}
                                widths={[280, 400, 560]}
                                sizes="(min-width: 768px) 280px, 45vw"
                            />
                        </figure>
                    )
                }
                <div class="numero-meta">
                    <h1>{pageTitle}</h1>
                    <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
                    <p class="numero-summary">{summary}</p>
                    {
                        (purchaseUrl || pdfUrl) && (
                            <div class="numero-actions">
                                {
                                    purchaseUrl && (
                                        <a
                                            class="numero-action numero-action--primary"
                                            href={purchaseUrl}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                        >
                                            Comprar en Ediciones LOM
                                        </a>
                                    )
                                }
                                {
                                    pdfUrl && (
                                        <a
                                            class="numero-action"
                                            href={pdfUrl}
                                            target="_blank"
                                            rel="noopener noreferrer"
                                        >
                                            Descargar PDF
                                        </a>
                                    )
                                }
                            </div>
                        )
                    }
                </div>
            </div>

            <NumeroIndex articles={articles} separataHrefs={separataHrefs} />

            {
                Content && (
                    <div class="numero-body">
                        <Content />
                    </div>
                )
            }
        </article>
    </main>
    <Footer />
</Layout>

<style>
    main {
        padding: 40px 0;
    }

    .numero {
        max-width: 900px;
    }

    .numero-back {
        display: inline-block;
        margin-bottom: 20px;
        font-size: 0.85rem;
        color: var(--color-primary);
        font-weight: 600;
    }

    .numero-header {
        display: flex;
        flex-direction: column;
        gap: 28px;
        margin-bottom: 10px;
    }

    @media (min-width: 768px) {
        .numero-header {
            flex-direction: row;
            align-items: flex-start;
            gap: 36px;
        }
    }

    .numero-cover {
        flex-shrink: 0;
        margin: 0;
        max-width: 280px;
    }

    .numero-cover img {
        width: 100%;
        aspect-ratio: 3 / 4;
        object-fit: cover;
        border-radius: 4px;
        box-shadow: 0 4px 16px var(--overlay-black-15);
    }

    .numero-meta h1 {
        font-family: "Libre Baskerville", serif;
        font-size: clamp(1.5rem, 4vw, 2rem);
        line-height: 1.25;
        margin-bottom: 12px;
        color: var(--color-neutral-900);
    }

    .numero-meta time {
        display: block;
        font-size: 0.85rem;
        color: var(--color-neutral-500);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 16px;
    }

    .numero-summary {
        font-size: 1.05rem;
        color: var(--color-neutral-700);
        line-height: 1.7;
        border-left: 4px solid var(--color-primary);
        padding-left: 20px;
        margin: 0 0 20px;
    }

    .numero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
    }

    .numero-action {
        display: inline-block;
        padding: 10px 18px;
        font-size: 0.85rem;
        font-weight: 600;
        text-decoration: none;
        border-radius: 4px;
        border: 2px solid var(--color-primary);
        color: var(--color-primary);
        transition: background 0.2s ease, color 0.2s ease;
    }

    .numero-action:hover {
        background: var(--color-primary);
        color: var(--color-white, #fff);
    }

    .numero-action--primary {
        background: var(--color-primary);
        color: var(--color-white, #fff);
    }

    .numero-action--primary:hover {
        opacity: 0.9;
    }

    .numero-body {
        font-size: 0.95rem;
        line-height: 1.8;
        color: var(--color-neutral-800);
        margin-top: 20px;
    }

    .numero-body :global(p) {
        margin-bottom: 20px;
    }
</style>
