---
import { withBase } from "../lib/url";
---

<header class="header">
  <div class="container">
    <div class="header-content">
      <a href={withBase("/")} class="logo">
        <img src={withBase("/img/logo.jpg")} alt="Actuel Marx Intervenciones" />
      </a>
      <div class="tagline">
        <span>UNA VARIANTE EDITORIAL DE LA REVISTA FRANCESA <em>ACTUEL MARX</em></span>
        <span class="issn">ISSN:0718-0179</span>
      </div>
    </div>
  </div>
</header>

<style>
  .header {
    background: var(--color-black);
    padding: 20px 0;
    border-bottom: 1px solid var(--overlay-white-10);
  }

  .header-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
  }

  .logo {
    display: flex;
    align-items: center;
  }

  .logo img {
    height: 64px;
    width: auto;
  }

  .tagline {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 5px;
    font-size: 0.75rem;
    color: var(--color-neutral-300);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .tagline em {
    font-style: italic;
    font-weight: 600;
  }

  .issn {
    font-weight: 700;
    color: var(--color-white);
    font-size: 0.85rem;
  }

  @media (max-width: 768px) {
    .header-content {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .logo {
      justify-content: center;
    }

    .logo img {
      height: 48px;
    }

    .tagline {
      align-items: center;
      text-align: center;
    }
  }
</style>
