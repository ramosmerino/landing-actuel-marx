---
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import Layout from "../layouts/Layout.astro";
import Header from "./Header.astro";
import Navigation from "./Navigation.astro";
import Footer from "./Footer.astro";
import { formatDate } from "../lib/formatDate";

export interface Props {
    title: string;
    pubDate?: Date;
    summary?: string;
    backHref: string;
    backLabel: string;
    Content: AstroComponentFactory;
}

const { title, pubDate, summary, backHref, backLabel, Content } = Astro.props;
const hasSlotContent = Astro.slots.has("default");

const jsonLd = {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: title,
    description: summary,
    inLanguage: "es-CL",
    ...(pubDate && { datePublished: pubDate.toISOString() }),
    publisher: { "@type": "Organization", name: "Actuel Marx Intervenciones" },
};
---

<Layout
    title={title}
    description={summary}
    type="article"
    publishedTime={pubDate}
    jsonLd={jsonLd}
>
    <Header />
    <Navigation />
    <main class="content-main">
        <div class="container">
            <article class="content-page entry">
                <a class="entry-back" href={backHref}>&larr; {backLabel}</a>
                <h1 class="content-page__title">{title}</h1>
                {pubDate && <time class="entry-date" datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>}
                {summary && <p class="entry-summary">{summary}</p>}
                {
                    hasSlotContent && (
                        <div class="entry-slot">
                            <slot />
                        </div>
                    )
                }
                <div class="content-prose entry-body">
                    <Content />
                </div>
            </article>
        </div>
    </main>
    <Footer />
</Layout>

<style>
    .content-main {
        padding: 40px 0 56px;
    }

    .entry-back {
        display: inline-block;
        margin-bottom: 20px;
        font-size: 0.85rem;
        color: var(--color-primary);
        font-weight: 600;
        text-decoration: none;
    }

    .entry-back:hover {
        text-decoration: underline;
    }

    .entry-date {
        display: block;
        font-size: 0.85rem;
        color: var(--color-neutral-500);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin: -8px 0 20px;
    }

    .entry-summary {
        font-size: 1.1rem;
        color: var(--color-neutral-700);
        line-height: 1.7;
        margin-bottom: 30px;
        border-left: 4px solid var(--color-primary);
        padding-left: 20px;
    }

    .entry-slot {
        margin-bottom: 28px;
    }

    .entry-body {
        margin-top: 8px;
    }
</style>
